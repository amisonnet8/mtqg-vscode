{
  "name": "mtqg",
  "displayName": "mtqg",
  "description": "Record assist and process view for mtqg (memo & rules, todo, qa & bugs, glossary).",
  "version": "0.1.0",
  "preview": true,
  "license": "MIT",
  "publisher": "amisonnet8",
  "repository": {
    "type": "git",
    "url": "https://github.com/amisonnet8/mtqg-vscode"
  },
  "bugs": {
    "url": "https://github.com/amisonnet8/mtqg-vscode/issues"
  },
  "homepage": "https://github.com/amisonnet8/mtqg-vscode#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mtqg",
    "memo",
    "todo",
    "qa",
    "journal"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mtqg.open",
        "title": "mtqg: Open",
        "icon": "$(book)"
      },
      {
        "command": "mtqg.createAt",
        "title": "mtqg: New Record Here"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mtqg.createAt",
          "group": "mtqg",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "editor/title": [
        {
          "command": "mtqg.open",
          "group": "navigation",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "~22.16.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
