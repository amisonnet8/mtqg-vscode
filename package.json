{
  "name": "mtqg",
  "displayName": "mtqg",
  "description": "mtqg for VS Code - browse and write your mtqg project journal (memo & rules, todo, qa & bugs, glossary) from inside the editor.",
  "version": "1.0.0",
  "license": "MIT",
  "publisher": "amisonnet8",
  "repository": {
    "type": "git",
    "url": "https://github.com/amisonnet8/mtqg-vscode"
  },
  "bugs": {
    "url": "https://github.com/amisonnet8/mtqg-vscode/issues"
  },
  "homepage": "https://github.com/amisonnet8/mtqg-vscode#readme",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mtqg",
    "journal",
    "memo",
    "todo",
    "qa",
    "bug",
    "glossary",
    "decision-log",
    "ai-agents",
    "git",
    "jsonl"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mtqg.open",
        "title": "mtqg: Open",
        "icon": {
          "light": "media/tab-icon-light.svg",
          "dark": "media/tab-icon-dark.svg"
        }
      },
      {
        "command": "mtqg.createAt",
        "title": "mtqg: New Record Here"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mtqg.createAt",
          "group": "mtqg",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "editor/title": [
        {
          "command": "mtqg.open",
          "group": "navigation",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "~22.16.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
