# Entry points for building and checking mtqg-vscode (.claude/rules/testing.md).

# Two separate tsc runs: the extension host (CommonJS, `vscode`'s types) and
# the Webview's own client script (ES modules, DOM types, no bundler --
# .claude/rules/dependencies.md). Kept as two tsconfig.json rather than one,
# since a single Node process can't be both CommonJS and browser-ESM.
#
# `rm -rf out` first: plain `tsc` (no --build/composite) never deletes output
# for a source file that was since deleted, so a removed test file keeps
# running from its stale compiled .js forever, inflating `qsoku unit`'s count
# (bug: `test/unit/commands/at.test.ts`'s removal alongside `mtqg.createAt`
# silently kept passing this way).
build: (cd //; rm -rf out && npx tsc -p . && npx tsc -p src/webview/client)

unit: (cd //; node --test 'out/test/unit/**/*.test.js')

check: qsoku build && qsoku unit

# Extension-host tests (test/vscode/): the real VS Code. Runs node:test's own
# run() inside the extension host (test/vscode/suite/index.ts) instead of
# mocha/@vscode/test-cli (.claude/rules/dependencies.md).
#
# xvfb-run only exists on Linux (this container, and CI's ubuntu-latest) --
# there is no display otherwise, so VS Code needs Xvfb's virtual one.
# windows-latest/macos-latest already have a real display and have no
# xvfb-run at all, so the branch below runs node directly there (todo
# b7fe931ffa: matrix-expanding CI to those two).
#
# ELECTRON_RUN_AS_NODE=1 is set repository-wide in this devcontainer (for the
# remote-cli `code` shim, .devcontainer/postCreate.sh). Inherited by a
# downloaded VS Code build, it makes that build's own Electron binary run as
# plain Node instead of launching the app, so every VS Code CLI flag fails
# with "bad option" (bug, todo 97779f964e). Unset it just for this run --
# harmless where it was never set (CI, any non-Linux OS) since unsetting an
# already-absent variable is a no-op.
test: qsoku build && (cd //; if command -v xvfb-run >/dev/null 2>&1; then env -u ELECTRON_RUN_AS_NODE xvfb-run -a node out/test/vscode/runTest.js; else node out/test/vscode/runTest.js; fi)

# --include-dev-deps: this project's runtime dependencies are always empty
# by design (.claude/rules/dependencies.md), so without this flag trivy scans
# nothing at all.
trivy: (cd //; trivy fs --config trivy.yaml --include-dev-deps .)

shellcheck: (cd //; git ls-files '*.sh' '*.bash' | xargs -r shellcheck)

# vsce reads package.json/.vscodeignore from the current directory. out/ is
# removed first: a stale out/src/webview/client/main.js (from before the
# root tsconfig excluded that directory, commit ac57f45) would otherwise
# ride along into the .vsix even though nothing loads it anymore (the
# Webview loads out/webview/main.js instead; found while packaging, todo
# 2f60eb9fb1).
package: (cd //; rm -rf out) && qsoku build && (cd //; npx vsce package)
